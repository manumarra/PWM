# Copiare questo file in ".env" e compilare i valori.

# Database MongoDB (locale o Atlas), con il nome del database in fondo all'indirizzo (es. fastfood)
MONGODB_URI=mongodb://127.0.0.1:27017/fastfood

# Segreto per firmare i token di sessione: una stringa lunga e casuale.
# Si può generare con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta del server (facoltativa, di default 3000)
PORT=3000

# Indirizzo con cui il browser raggiunge l'app (Stripe lo usa per riportare il cliente al sito)
APP_URL=http://localhost:3000

# Pagamenti con Stripe (facoltativi). Se STRIPE_SECRET_KEY è vuota i pagamenti sono SIMULATI.
# Usare solo chiavi di prova (sk_test_...).
STRIPE_SECRET_KEY=

# Solo se si usa il webhook con la Stripe CLI: il valore whsec_... stampato da "stripe listen"
STRIPE_WEBHOOK_SECRET=

# Impostare a "production" solo se il sito è servito in HTTPS (rende il cookie di sessione "secure")
# NODE_ENV=development